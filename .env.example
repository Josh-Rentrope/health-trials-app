# Copy to .env.local (same directory as package.json) and fill in.
#
# Next.js loads .env, .env.local, .env.development, .env.development.local from
# the PROJECT ROOT -- the folder containing package.json, not the repo parent.
#
# NEXT_PUBLIC_* values are INLINED INTO THE CLIENT BUNDLE at build time. Two
# consequences that are easy to trip over:
#   1. Editing this file has no effect until the dev server is restarted.
#   2. The value must be present when the build runs. On App Platform that means
#      scope = BUILD_TIME in Terraform, not RUN_TIME.
#
# If the map is blank but the page loads, the token is missing or was not present
# at build time; check the browser console for a Mapbox 401.

NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# Where the API lives. Leave it unset for a same-origin deployment.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
